# ── LLM Provider (set exactly ONE) ─────────────────────────────────────────
# OpenAI (default)
OPENAI_API_KEY=sk-...your-openai-key...

# Or Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...
# LLM_PROVIDER=anthropic          # "openai" | "anthropic"  (defaults to "openai")

# ── Optional tuning ─────────────────────────────────────────────────────────
# LLM_MODEL=gpt-4o-mini           # model name to use (provider-specific)
# MAX_ROUNDS=6                    # max negotiation rounds
