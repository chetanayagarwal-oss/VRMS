# ── LLM Provider (set exactly ONE) ─────────────────────────────────────────
# OpenAI (default)
OPENAI_API_KEY=sk-...your-openai-key...

# Or Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...
# LLM_PROVIDER=openai             # "openai" | "anthropic" (defaults to "openai")
# LLM_MODEL=gpt-4o-mini           # model name to use (provider-specific)
# MAX_ROUNDS=6                    # max negotiation rounds

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-32-byte-hex-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS Configuration (comma-separated, NO "*") ─────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
