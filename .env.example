# ── SwipeGig Frontend Environment Variables ───────────────────────────────

# Backend API Endpoint
VITE_API_URL=http://localhost:8000

# Web3 Smart Contract Addresses (Sepolia Testnet)
VITE_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Client Analytics Tracking ("true" to enable, false by default)
VITE_ANALYTICS_ENABLED=false
